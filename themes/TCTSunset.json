{
  "name": "TCT Sunset",
  "type": "dark",
  "colors": {
    "editor.background": "#331f27",
    "editor.foreground": "#fddac7",
    "editorLineNumber.foreground": "#fc9776",
    "editor.selectionBackground": "#fa5a2855",
    "editor.inactiveSelectionBackground": "#fa5a2822",
    "editorCursor.foreground": "#ffae00",
    "activityBar.background": "#44242c",
    "sideBar.background": "#44242c",
    "statusBar.background": "#44242c",
    "terminal.foreground": "#fed7aa",
    "titleBar.activeBackground": "#5a2d39",
    "tab.activeBackground": "#5a2d39",
    "editorBracketHighlight.foreground1": "#e06c75",
    "editorBracketHighlight.foreground2": "#d19a66",
    "editorBracketHighlight.foreground3": "#e5c07b",
    "editorBracketHighlight.foreground4": "#98c379",
    "editorBracketHighlight.foreground5": "#56b6c2",
    "editorBracketHighlight.foreground6": "#c678dd"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ebb09f"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#ffd2b1"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#fc9776",
        "fontStyle": ""
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#ffc18e"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#fda67e"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#4EC9B0",
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "struct": "#4EC9B0",
    "interface": "#4EC9B0",
    "enum": "#4EC9B0",
    "typeParameter": "#E5C07B",
    "parameter": "#E5C07B",
    "variable": "#ffc18e",
    "variable.readonly": "#D19A66",
    "variable.defaultLibrary": "#4EC9B0",
    "property": "#ffc18e",
    "property.readonly": "#D19A66",
    "enumMember": "#D19A66",
    "event": "#61AFEF",
    "function": "#61AFEF",
    "function.declaration": "#61AFEF",
    "method": "#61AFEF",
    "method.declaration": "#61AFEF",
    "member.declaration": "#61AFEF",
    "decorator": "#E5C07B",
    "macro": "#D19A66",
    "label": "#ffc18e",
    "comment": "#ebb09f",
    "string": "#ffd2b1",
    "keyword": "#fc9776",
    "keyword.control": "#fc9776",
    "number": "#D19A66",
    "regexp": "#ffd2b1",
    "operator": "#fc9776"
  }
}
