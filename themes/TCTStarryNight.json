{
  "name": "TCT Starry Night",
  "type": "dark",
  "colors": {
    "editor.background": "#1b1a2c",
    "editor.foreground": "#dfe7ff",
    "editorLineNumber.foreground": "#7c7eff",
    "editor.selectionBackground": "#4a4ade44",
    "editor.inactiveSelectionBackground": "#4a4ade22",
    "editorCursor.foreground": "#ffae00",
    "activityBar.background": "#232341",
    "sideBar.background": "#232341",
    "statusBar.background": "#232341",
    "terminal.foreground": "#cfd7ff",
    "titleBar.activeBackground": "#38385d",
    "tab.activeBackground": "#38385d",
    "editorBracketHighlight.foreground1": "#e06c75",
    "editorBracketHighlight.foreground2": "#d19a66",
    "editorBracketHighlight.foreground3": "#e5c07b",
    "editorBracketHighlight.foreground4": "#98c379",
    "editorBracketHighlight.foreground5": "#56b6c2",
    "editorBracketHighlight.foreground6": "#c678dd"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a2adfa"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#f2dfff"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#b8b9ff"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#dee2ff"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#9a8fff"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#4EC9B0",
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "struct": "#4EC9B0",
    "interface": "#4EC9B0",
    "enum": "#4EC9B0",
    "typeParameter": "#E5C07B",
    "parameter": "#E5C07B",
    "variable": "#dee2ff",
    "variable.readonly": "#D19A66",
    "variable.defaultLibrary": "#4EC9B0",
    "property": "#dee2ff",
    "property.readonly": "#D19A66",
    "enumMember": "#D19A66",
    "event": "#61AFEF",
    "function": "#61AFEF",
    "function.declaration": "#61AFEF",
    "method": "#61AFEF",
    "method.declaration": "#61AFEF",
    "member.declaration": "#61AFEF",
    "decorator": "#E5C07B",
    "macro": "#D19A66",
    "label": "#dee2ff",
    "comment": "#a2adfa",
    "string": "#f2dfff",
    "keyword": "#b8b9ff",
    "keyword.control": "#b8b9ff",
    "number": "#D19A66",
    "regexp": "#f2dfff",
    "operator": "#b8b9ff"
  }
}
