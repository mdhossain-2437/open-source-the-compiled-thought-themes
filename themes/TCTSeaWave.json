{
  "name": "TCT Sea Wave",
  "type": "dark",
  "colors": {
    "editor.background": "#0f172a",
    "editor.foreground": "#cbd5e1",
    "editorLineNumber.foreground": "#38bdf8",
    "editor.selectionBackground": "#38bdf835",
    "editor.inactiveSelectionBackground": "#38bdf822",
    "editorCursor.foreground": "#ffae00",
    "activityBar.background": "#132749",
    "sideBar.background": "#132749",
    "statusBar.background": "#132749",
    "terminal.foreground": "#94a3b8",
    "titleBar.activeBackground": "#1d3762",
    "tab.activeBackground": "#1d3762",
    "editorBracketHighlight.foreground1": "#e06c75",
    "editorBracketHighlight.foreground2": "#d19a66",
    "editorBracketHighlight.foreground3": "#e5c07b",
    "editorBracketHighlight.foreground4": "#98c379",
    "editorBracketHighlight.foreground5": "#56b6c2",
    "editorBracketHighlight.foreground6": "#c678dd"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#94a3b8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#a5f3fc"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#38bdf8"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#4EC9B0",
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "struct": "#4EC9B0",
    "interface": "#4EC9B0",
    "enum": "#4EC9B0",
    "typeParameter": "#E5C07B",
    "parameter": "#E5C07B",
    "variable": "#cbd5e1",
    "variable.readonly": "#D19A66",
    "variable.defaultLibrary": "#4EC9B0",
    "property": "#cbd5e1",
    "property.readonly": "#D19A66",
    "enumMember": "#D19A66",
    "event": "#61AFEF",
    "function": "#61AFEF",
    "function.declaration": "#61AFEF",
    "method": "#61AFEF",
    "method.declaration": "#61AFEF",
    "member.declaration": "#61AFEF",
    "decorator": "#E5C07B",
    "macro": "#D19A66",
    "label": "#cbd5e1",
    "comment": "#94a3b8",
    "string": "#a5f3fc",
    "keyword": "#38bdf8",
    "keyword.control": "#38bdf8",
    "number": "#D19A66",
    "regexp": "#a5f3fc",
    "operator": "#38bdf8"
  }
}
