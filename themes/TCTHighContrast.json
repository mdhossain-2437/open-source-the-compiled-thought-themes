{
  "name": "TCT High Contrast",
  "type": "dark",
  "include": "./_ui.json",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "editor.lineHighlightBackground": "#202020",
    "editor.selectionBackground": "#404040",
    "editorCursor.foreground": "#FFFFFF",
    "activityBar.background": "#000000",
    "sideBar.background": "#000000"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#00FF00"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#FF00FF"
      }
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#FFFF00"
      }
    },
    {
      "name": "Class, Type",
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "settings": {
        "foreground": "#FF0000"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#FFFF00"
      }
    },
    {
      "name": "Error",
      "scope": "invalid",
      "settings": {
        "foreground": "#FF0000"
      }
    }
  ]
}
