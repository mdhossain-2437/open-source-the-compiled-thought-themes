{
  "name": "TCT Candyland",
  "type": "dark",
  "colors": {
    "editor.background": "#231627",
    "editor.foreground": "#e0cde4",
    "editorLineNumber.foreground": "#ab87b3",
    "editor.selectionBackground": "#d946ef20",
    "editor.inactiveSelectionBackground": "#9f4daf20",
    "editorCursor.foreground": "#f9a8d4",

    "activityBar.background": "#2f1f35",
    "sideBar.background": "#2f1f35",
    "statusBar.background": "#2f1f35",
    "terminal.foreground": "#fde68a",
    "titleBar.activeBackground": "#3b2842",
    "tab.activeBackground": "#3b2842",

    "editorBracketHighlight.foreground1": "#f9a8d4",
    "editorBracketHighlight.foreground2": "#fde68a",
    "editorBracketHighlight.foreground3": "#a7f3d0",
    "editorBracketHighlight.foreground4": "#a5f3fc",
    "editorBracketHighlight.foreground5": "#c084fc",
    "editorBracketHighlight.foreground6": "#fbcfe8"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ab87b3"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#fde68a"
      }
    },
    {
      "scope": "keyword, storage.type, storage.modifier",
      "settings": {
        "foreground": "#f9a8d4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#e0cde4"
      }
    },
    {
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#a7f3d0"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "settings": {
        "foreground": "#a5f3fc"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#fbcfe8"
      }
    }
  ]
}
