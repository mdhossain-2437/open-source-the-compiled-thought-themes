{
  "name": "TCT Candyland",
  "type": "dark",
  "colors": {
    "editor.background": "#2a1e2f",
    "editor.foreground": "#f4e2f7",
    "editorLineNumber.foreground": "#fbcfe8",
    "editor.selectionBackground": "#d946ef33",
    "editor.inactiveSelectionBackground": "#9f4daf33",
    "editorCursor.foreground": "#ffae00",
    "activityBar.background": "#3b2c43",
    "sideBar.background": "#3b2c43",
    "statusBar.background": "#3b2c43",
    "terminal.foreground": "#fde68a",
    "titleBar.activeBackground": "#4c3a57",
    "tab.activeBackground": "#4c3a57",
    "editorBracketHighlight.foreground1": "#e06c75",
    "editorBracketHighlight.foreground2": "#d19a66",
    "editorBracketHighlight.foreground3": "#e5c07b",
    "editorBracketHighlight.foreground4": "#98c379",
    "editorBracketHighlight.foreground5": "#56b6c2",
    "editorBracketHighlight.foreground6": "#c678dd"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#fed7e2"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#fae8fc"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#f9a8d4",
        "fontStyle": ""
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#fef08a"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#c084fc"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#4EC9B0",
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "struct": "#4EC9B0",
    "interface": "#4EC9B0",
    "enum": "#4EC9B0",
    "typeParameter": "#E5C07B",
    "parameter": "#E5C07B",
    "variable": "#fef08a",
    "variable.readonly": "#D19A66",
    "variable.defaultLibrary": "#4EC9B0",
    "property": "#fef08a",
    "property.readonly": "#D19A66",
    "enumMember": "#D19A66",
    "event": "#61AFEF",
    "function": "#61AFEF",
    "function.declaration": "#61AFEF",
    "method": "#61AFEF",
    "method.declaration": "#61AFEF",
    "member.declaration": "#61AFEF",
    "decorator": "#E5C07B",
    "macro": "#D19A66",
    "label": "#fef08a",
    "comment": "#fed7e2",
    "string": "#fae8fc",
    "keyword": "#f9a8d4",
    "keyword.control": "#f9a8d4",
    "number": "#D19A66",
    "regexp": "#fae8fc",
    "operator": "#f9a8d4"
  }
}
