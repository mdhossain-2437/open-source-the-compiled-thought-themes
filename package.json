        "command": "DelowarHossain.selectTheme",
        "title": "TCT: Select Theme"
      },
      {
        "command": "DelowarHossain.toggleItalic",
        "title": "TCT: Toggle Italic Variant"
      },
      {
        "command": "DelowarHossain.enableAutoTheme",
        "title": "TCT: Enable Auto Theme Switching"
      },
      {
        "command": "DelowarHossain.previewTheme",
        "title": "TCT: Preview Themes"
      },
      {
        "command": "DelowarHossain.viewThemeAnalytics",
        "title": "TCT: View Theme Analytics"
      },
      {
        "command": "DelowarHossain.shareTheme",
        "title": "TCT: Share Current Theme"
      },
      {
        "command": "DelowarHossain.configureSchedule",
        "title": "TCT: Configure Theme Schedule"
      },
      {
        "command": "DelowarHossain.customizeIcons",
        "title": "TCT: Customize Icon Pack"
      },
      {
        "command": "DelowarHossain.configureWorkspaceTheme",
        "title": "TCT: Configure Workspace Theme"
      },
      {
        "command": "DelowarHossain.customizeKeyboardShortcuts",
        "title": "TCT: Customize Theme Shortcuts"
      }
    ],
    "configuration": {
      "title": "TCT Extension Settings",
      "properties": {
        "DelowarHossain.enableItalic": {
          "type": "boolean",
          "default": true,
          "description": "Enable italic variants for themes that support it"
        },
        "DelowarHossain.autoTheme": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch themes based on time and context"
        },
        "DelowarHossain.fontFamily": {
          "type": "string",
          "default": "Operator Mono, Fira Code, JetBrains Mono, Cascadia Code, Consolas, monospace",
          "description": "Optimized font family for coding"
        },
        "DelowarHossain.fontLigatures": {
          "type": "boolean",
          "default": true,
          "description": "Enable font ligatures for better code readability"
        },
        "DelowarHossain.smartRecommendations": {
          "type": "boolean",
          "default": true,
          "description": "Enable smart theme recommendations based on file type and time"
        },
        "tct.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered features using Gemini"
        },
        "tct.ai.suggestions": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI code suggestions and theme recommendations"
        },
        "tct.ai.codeAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI code analysis for bug detection"
        },
        "tct.themes.customization": {
          "type": "object",
          "default": {},
          "description": "Store custom theme configurations"
        },
        "tct.analytics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable theme usage analytics to improve recommendations"
        },
        "tct.community.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable community features like theme sharing and ratings"
        },
        "tct.scheduling.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable theme scheduling based on time zones"
        },
        "tct.scheduling.timeZone": {
          "type": "string",
          "default": "auto",
          "description": "Time zone for theme scheduling (auto or IANA time zone name)"
        },
        "tct.iconPacks": {
          "type": "object",
          "default": {
            "selected": "material-design",
            "custom": {}
          },
          "description": "Icon pack configuration and custom icon mappings"
        },
        "tct.workspace.themeOverrides": {
          "type": "object",
          "default": {},
          "description": "Workspace-specific theme settings and overrides"
        },
        "tct.keyboardShortcuts": {
          "type": "object",
          "default": {},
          "description": "Custom keyboard shortcuts for theme actions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node ./scripts/version.js && vsce package --no-dependencies",
    "publish": "node ./scripts/version.js && vsce publish",
    "release": "node ./scripts/release.js",
    "clean": "node node_modules/rimraf/bin.js out",
    "precompile": "npm run clean",
    "version:bump": "node ./scripts/version.js bump",
    "changelog": "node ./scripts/version.js changelog",
    "icons:sync": "node ./scripts/sync-icons.js",
    "icons:optimize": "node ./scripts/optimize-icons.js",
    "dev": "npm run watch",
    "build": "npm run clean && npm run compile",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run lint && npm run test",
    "prepare": "husky install",
    "prebuild": "npm run validate",
    "prepackage": "npm run build",
    "postinstall": "node ./scripts/setup-dev.js",
    "start": "npm run dev",
    "dev:full": "concurrently \"npm run watch\" \"npm run test:watch\"",
    "verify": "npm run lint && npm run test && npm run build",
    "release:major": "node ./scripts/release.js major",
    "release:minor": "node ./scripts/release.js minor",
    "release:patch": "node ./scripts/release.js patch",
    "ci": "npm run clean && npm run verify && npm run package",
    "docs": "typedoc --out docs src",
    "analyze": "npm audit && npm outdated",
    "update-deps": "npm update && npm audit fix",
    "all": "npm run clean && npm run verify && npm run package && npm run docs"
  },
